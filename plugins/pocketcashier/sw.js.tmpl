// Karots Pocket Cashier service worker: the app opens with no server. Built by
// the server, with this version's files listed. /api/* is never cached.
const VERSION = {{.Version}}
const FILES = {{.Files}}
const CACHE = 'ks-pocket-' + VERSION

self.addEventListener('install', (e) => {
  e.waitUntil(caches.open(CACHE).then((c) => c.addAll([...FILES, "/x/pocketcashier/"])).then(() => self.skipWaiting()))
})

self.addEventListener('activate', (e) => {
  e.waitUntil(
    caches.keys()
      .then((keys) => Promise.all(keys.filter((k) => k.startsWith('ks-pocket-') && k !== CACHE).map((k) => caches.delete(k))))
      .then(() => self.clients.claim()),
  )
})

self.addEventListener('fetch', (e) => {
  const req = e.request
  const url = new URL(req.url)
  if (req.method !== 'GET' || url.origin !== self.location.origin || url.pathname.startsWith('/api/')) return
  if (req.mode === 'navigate') {
    // Network first (a new version shows at once); the cached app when the PC is down.
    e.respondWith(fetch(req).catch(() => caches.match('/index.html', { cacheName: CACHE })))
    return
  }
  // Hashed assets and icons: the cache first.
  e.respondWith(caches.match(req, { cacheName: CACHE }).then((hit) => hit || fetch(req)))
})
